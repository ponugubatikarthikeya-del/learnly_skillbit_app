<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- 🔒 Production Security: Forces all traffic to use HTTPS -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>

    <!-- 🛠️ Development Flexibility: Only active in debug builds -->
    <!-- This allows you to inspect network/ad traffic using proxy tools -->
    <debug-overrides>
        <trust-anchors>
            <certificates src="user" />
            <certificates src="system" />
        </trust-anchors>
    </debug-overrides>
</network-security-config>