<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:orientation="vertical"
        android:background="@drawable/gradient_bg"
        android:layout_gravity="center"
        android:gravity="center"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <TextView
            android:id="@+id/titleText"
            android:text="@string/tic_toc_toe"
            android:textSize="32sp"
            android:textAlignment="center"
            android:textColor="@android:color/white"
            android:layout_marginBottom="4dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/offline"
            android:textColor="@color/white"
            android:layout_marginBottom="12dp"/>

        <GridLayout
                android:id="@+id/gridLayout"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:columnCount="3"
                android:rowCount="3"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="16dp">

                <Button
                    android:id="@+id/ticBtn1"
                    style="@style/CellStyle"
                    android:contentDescription="@string/tic_cell1"
                   android:importantForAccessibility="no" />

                <Button
                    android:id="@+id/ticBtn2"
                    style="@style/CellStyle"
                    android:contentDescription="@string/tic_cell2"
                   android:importantForAccessibility="no" />

                <Button
                    android:id="@+id/ticBtn3"
                    style="@style/CellStyle"
                    android:contentDescription="@string/tic_cell3"
                 android:importantForAccessibility="no"/>

                <Button
                    android:id="@+id/ticBtn4"
                    style="@style/CellStyle"
                    android:contentDescription="@string/tic_cell4"
                   android:importantForAccessibility="no"/>

                <Button
                    android:id="@+id/btn5"
                    style="@style/CellStyle"
                    android:contentDescription="@string/tic_cell5"
                   android:importantForAccessibility="no" />

                <Button
                    android:id="@+id/ticBtn6"
                    style="@style/CellStyle"
                    android:contentDescription="@string/tic_cell6"
                    android:importantForAccessibility="no" />

                <Button
                    android:id="@+id/ticBtn7"
                    style="@style/CellStyle"
                    android:contentDescription="@string/tic_cell7"
                  android:importantForAccessibility="no"/>

                <Button
                    android:id="@+id/ticBtn8"
                    style="@style/CellStyle"
                    android:contentDescription="@string/tic_cell8"
                    android:importantForAccessibility="no"/>

                <Button
                    android:id="@+id/ticBtn9"
                    style="@style/CellStyle"
                    android:contentDescription="@string/tic_cell9"
                    android:importantForAccessibility="no"/>
            </GridLayout>

        <TextView
            android:id="@+id/statusText"
            android:text="@string/start_playing"
            android:textColor="@android:color/white"
            android:textSize="20sp"
            android:layout_marginTop="20dp"
            android:shadowColor="@color/tic_shadowColor"
            android:shadowDx="0"
            android:shadowDy="0"
            android:shadowRadius="2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />

        <Button
            android:id="@+id/ticBackButton"
            android:layout_width="180dp"
            android:layout_height="60dp"
            android:text="@string/back"
            android:textAllCaps="true"
            android:textStyle="bold"
            android:textColor="@android:color/white"
            android:textSize="16sp"
            android:gravity="center"
            android:backgroundTint="@color/purple_700"
            android:layout_marginTop="28dp"
            android:elevation="8dp"
            android:translationZ="4dp"
            android:paddingHorizontal="12dp"
            android:contentDescription="@string/move_backSide"
            android:layout_gravity="center_horizontal"/>


    </LinearLayout>

    <FrameLayout
        android:id="@+id/celebrationView"
        android:visibility="gone"
        android:background="@color/tic_overlay_bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <TextView
            android:id="@+id/winnerText"
            android:text="@string/player_x_won"
            android:textSize="36sp"
            android:textColor="@android:color/white"
            android:gravity="center"
            android:alpha="0"
            android:layout_gravity="center"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />
    </FrameLayout>

</merge>

