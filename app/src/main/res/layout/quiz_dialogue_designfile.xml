<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    app:cardElevation="8dp"
    app:strokeColor="@color/white"
    app:strokeWidth="0dp"
    app:cardCornerRadius="20dp"
    android:background="@drawable/dialog_bg"
    android:backgroundTint="@color/white"
    android:layout_margin="7dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        >

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Quiz completed"
            android:textStyle="bold"
            android:textColor="@color/black"
            android:textSize="40sp"
            android:padding="10dp"
            android:layout_gravity="center"
            android:layout_marginTop="30dp"/>

        <ImageView
            android:id="@+id/quizImage"
            android:layout_width="150dp"
            android:layout_height="150dp"
            android:src="@drawable/quiz_score_dialogue"
            android:layout_marginTop="7dp"
            android:layout_gravity="center"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Your Score : "
            android:textSize="30sp"
            android:textStyle="bold"
            android:textColor="#5D5555"
            android:layout_gravity="center"/>


        <TextView
            android:id="@+id/dialogQuizScore"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="5/10"
            android:textSize="50sp"
            android:textStyle="bold"
            android:textColor="#500ACC"
            android:layout_marginTop="10dp"
            android:layout_gravity="center"/>


        <TextView
            android:id="@+id/userPerformance"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Keep practicing ! 💪"
            android:textSize="30sp"
            android:textStyle="bold"
            android:textColor="@color/black"
            android:layout_marginTop="10dp"
            android:layout_gravity="center"/>


        <TextView
            android:id="@+id/returnBtn"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Return"
            android:textSize="20sp"
            android:textColor="#4F16B6"
            android:layout_marginTop="10dp"
            android:layout_gravity="center"
            android:padding="40dp"/>








    </LinearLayout>




</com.google.android.material.card.MaterialCardView>