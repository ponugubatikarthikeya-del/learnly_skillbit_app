<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/pageBagrounds"
    android:paddingTop="30dp">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        tools:ignore="UselessParent">

            <RelativeLayout
                android:id="@+id/relative_action"
                android:layout_width="match_parent"
                android:layout_height="55dp"
                android:background="#2E2A3A"
               >

                <ImageButton
                    android:id="@+id/FactDisplayBack"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentStart="true"
                    android:layout_centerInParent="true"
                    android:layout_marginStart="15dp"
                    android:background="#2E2A3A"
                    android:contentDescription="@string/move_backSide"
                    android:scaleType="centerCrop"
                    android:src="@drawable/back_arrow"
                    app:tint="@color/white"
                    tools:ignore="TouchTargetSizeCheck" />

                <TextView
                    android:id="@+id/display_category_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentTop="true"
                    android:layout_marginStart="10dp"
                    android:layout_toEndOf="@id/FactDisplayBack"
                    android:padding="5dp"
                    android:text="@string/category"
                    android:textColor="@color/white"
                    android:textSize="30sp"
                    android:gravity="center"/>
            </RelativeLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:layout_margin="5dp"
            android:layout_below="@id/relative_action">
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/FactDisplayRecycle"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:padding="8dp"
                android:layout_gravity="center" />

        </LinearLayout>
    </RelativeLayout>
</RelativeLayout>
