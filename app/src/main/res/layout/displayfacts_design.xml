<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="16dp"
    android:layout_marginBottom="24dp"
    app:cardElevation="6dp"
    app:cardCornerRadius="32dp"
    app:strokeWidth="1dp"
    app:strokeColor="@color/outline_variant"
    app:cardBackgroundColor="@color/surface">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- Header / Gradient Area -->
        <FrameLayout
            android:id="@+id/factContainer"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:padding="24dp"
            android:background="@drawable/card_gradient_indigo"
            android:minHeight="240dp">

            <TextView
                android:id="@+id/text_fact"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_gravity="center"
                android:gravity="center"
                android:textColor="@color/white"
                android:lineSpacingMultiplier="1.2"
                android:textSize="14sp"
                android:lineSpacingExtra="4dp"
                android:textStyle="bold"
                app:autoSizeMinTextSize="14sp"
                app:autoSizeMaxTextSize="24sp"
                tools:text="This is an interesting fact that is displayed beautifully." />

            <!-- Quote Decor -->
            <ImageView
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_gravity="top|start"
                android:alpha="0.2"
                android:src="@drawable/outline_local_library_24"
                app:tint="@color/white"
                android:contentDescription="@string/carddesignicon"/>

        </FrameLayout>

        <!-- Actions -->
        <LinearLayout
            android:id="@+id/factButtonView"
            android:layout_width="match_parent"
            android:layout_height="72dp"
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingHorizontal="16dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_copy"
                style="@style/Widget.Material3.Button.IconButton"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginEnd="16dp"
                app:icon="@drawable/round_content_copy_24"
                app:iconTint="@color/on_surface_variant"
                android:contentDescription="@string/copybtn"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_like"
                style="@style/Widget.Material3.Button.IconButton"
                android:layout_width="48dp"
                android:layout_height="48dp"
                app:icon="@drawable/baseline_favorite_border_24"
                app:iconTint="@color/red"
                android:contentDescription="@string/likeBtn"/>

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_share"
                style="@style/Widget.Material3.Button.ElevatedButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/share"
                app:icon="@drawable/baseline_share_24"
                app:cornerRadius="12dp" />

        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
