<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    app:cardElevation="8dp"
    app:strokeColor="@color/white"
    app:strokeWidth="0dp"
    app:cardCornerRadius="20dp"
    android:layout_gravity="center"
    app:cardBackgroundColor="@color/white"
    android:layout_margin="7dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:layout_gravity="center"
        android:orientation="vertical">

        <TextView
            android:id="@+id/ticWinnerName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/you_win"
            android:textSize="40sp"
            android:textStyle="bold"
            android:textColor="@color/yellow_accent"
            android:gravity="center"
            android:layout_gravity="center"
           android:layout_margin="20dp"/>


        <ImageView
            android:layout_width="120dp"
            android:layout_height="120dp"
            android:contentDescription="@string/won_symbol"
            android:scaleType="center"
            android:src="@drawable/trophy"
            tools:ignore="ImageContrastCheck" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginTop="20dp"
            android:gravity="center"
            android:layout_margin="20dp"
            android:orientation="horizontal"
            android:paddingStart="15dp"
            android:paddingEnd="15dp"
            android:weightSum="2">

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/ticDialogBack"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_gravity="center"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:backgroundTint="@color/white"
                android:clickable="true"
                android:elevation="2dp"
                android:focusable="true"
                app:cardCornerRadius="20dp"
                android:contentDescription="@string/back"
                tools:ignore="SpeakDuplicateContent,TextSizeCheck"
                app:strokeWidth="0dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:text="@string/back"
                    android:textColor="@color/black"
                    android:contentDescription="@string/back"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp"
                    android:drawablePadding="4dp"/>


            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/ticDialogReset"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_gravity="center"
                android:layout_marginStart="12dp"
                android:layout_marginEnd="10dp"
                android:layout_weight="1"
                android:backgroundTint="@color/white"
                android:clickable="true"
                android:contentDescription="@string/reset"
                android:elevation="2dp"
                android:focusable="true"
                app:cardCornerRadius="20dp"
                app:strokeWidth="0dp"
                tools:ignore="SpeakDuplicateContent,TextSizeCheck"
                >

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="@string/reset"
                    android:gravity="center"
                    android:text="@string/reset"
                    android:textColor="@color/black"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp"
                    android:drawablePadding="4dp"/>


            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>
    </LinearLayout>



</androidx.cardview.widget.CardView>