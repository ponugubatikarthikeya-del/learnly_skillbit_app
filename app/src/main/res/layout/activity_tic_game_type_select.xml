<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/menu_bg">

    <!-- Back Button -->
    <ImageButton
        android:id="@+id/ticSelBack"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginStart="16dp"
        android:layout_marginTop="16dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/back"
        android:src="@drawable/back_arrow"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:tint="@android:color/white" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="vertical"
        app:layout_constraintBottom_toTopOf="@+id/ad_container_sel"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <!-- Title -->
        <TextView
            android:id="@+id/titleText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="40dp"
            android:letterSpacing="0.1"
            android:shadowColor="@color/tic_homePg_titleBg"
            android:shadowDx="2"
            android:shadowDy="2"
            android:shadowRadius="8"
            android:text="@string/tic_toc_toe"
            android:textColor="@android:color/white"
            android:textSize="34sp"
            android:textStyle="bold" />

        <!-- Multiplayer Button -->
        <Button
            android:id="@+id/multiplayerButton"
            android:layout_width="220dp"
            android:layout_height="60dp"
            android:layout_marginBottom="25dp"
            android:background="@drawable/btn_purple_gradient"
            android:elevation="8dp"
            android:minWidth="220dp"
            android:minHeight="60dp"
            android:stateListAnimator="@null"
            android:text="@string/tic_Multiplayer"
            android:textAllCaps="true"
            android:textColor="@color/tic_homePg_buttonText"
            android:textSize="18sp"
            android:textStyle="bold"
            tools:ignore="TouchTargetSizeCheck" />

        <!-- Computer vs You Button -->
        <Button
            android:id="@+id/computerButton"
            android:layout_width="220dp"
            android:layout_height="60dp"
            android:background="@drawable/btn_blue_gradient"
            android:elevation="8dp"
            android:minWidth="220dp"
            android:minHeight="60dp"
            android:stateListAnimator="@null"
            android:text="@string/com_vs_you"
            android:textAllCaps="true"
            android:textColor="@color/tic_homePg_buttonText"
            android:textSize="18sp"
            android:textStyle="bold"
            tools:ignore="TouchTargetSizeCheck" />

    </LinearLayout>

    <!-- Ad Container -->
    <FrameLayout
        android:id="@+id/ad_container_sel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="50dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
