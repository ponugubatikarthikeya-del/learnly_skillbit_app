<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/snake_viewPage_bg">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <!-- Title -->
        <TextView
            android:id="@+id/titleText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/snake_game"
            android:textSize="34sp"
            android:textStyle="bold"
            android:gravity="center"
            android:textColor="@color/snake_textActivity"
            android:layout_marginTop="28dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />


        <TextView
            android:id="@+id/offlineText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="@string/offline"
            android:textSize="20sp"
            android:textColor="@color/black"
            app:layout_constraintEnd_toEndOf="@+id/titleText"
            app:layout_constraintStart_toStartOf="@+id/titleText"
            app:layout_constraintTop_toBottomOf="@id/titleText" />

        <!-- Score -->
        <TextView
            android:id="@+id/scoreText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/score_0"
            android:textSize="22sp"
            android:textColor="@color/snakeGame_scoreBg"
            android:gravity="center"
            android:layout_marginTop="12dp"
            app:layout_constraintTop_toBottomOf="@id/offlineText"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- SNAKE GAME VIEW -->
        <com.factifyft.app.GameView
            android:id="@+id/gameView"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:layout_marginTop="25dp"
            android:layout_marginBottom="18dp"
            app:layout_constraintTop_toBottomOf="@id/scoreText"
            app:layout_constraintBottom_toTopOf="@id/controlContainer"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintDimensionRatio="1:1" />

        <!-- START BUTTON (centered on GameView) -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnStart"
            android:layout_width="160dp"
            android:layout_height="60dp"
            android:text="@string/start"
            android:textColor="@color/snakeGame_startBg"
            android:textStyle="bold"
            android:textSize="18sp"
            app:cornerRadius="30dp"
            android:visibility="visible"
            app:layout_constraintTop_toTopOf="@id/gameView"
            app:layout_constraintBottom_toBottomOf="@id/gameView"
            app:layout_constraintStart_toStartOf="@id/gameView"
            app:layout_constraintEnd_toEndOf="@id/gameView" />

        <!-- CONTROL BUTTONS -->
        <LinearLayout
            android:id="@+id/controlContainer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:layout_marginBottom="80dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintBottom_toBottomOf="parent">

            <!-- Up Button -->
            <ImageButton
                android:id="@+id/btnUp"
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:background="@drawable/button_dark"
                android:src="@drawable/baseline_arrow_drop_up_24"
                android:contentDescription="@string/sGame_button_up"
                app:tint="@color/snakeGm_controlBtn_arrowCl"
                android:scaleType="center" />

            <!-- Left / Down / Right Buttons -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center"
                android:layout_marginTop="8dp">

                <ImageButton
                    android:id="@+id/btnLeft"
                    android:layout_width="72dp"
                    android:layout_height="72dp"
                    android:background="@drawable/button_dark"
                    android:src="@drawable/baseline_arrow_left_24"
                    android:contentDescription="@string/sGame_button_left"
                    app:tint="@color/snakeGm_controlBtn_arrowCl"
                    android:scaleType="center"
                    android:layout_marginEnd="8dp" />

                <ImageButton
                    android:id="@+id/btnDown"
                    android:layout_width="72dp"
                    android:layout_height="72dp"
                    android:background="@drawable/button_dark"
                    android:src="@drawable/baseline_arrow_drop_down_24"
                    android:contentDescription="@string/sGame_button_down"
                    app:tint="@color/snakeGm_controlBtn_arrowCl"
                    android:scaleType="center" />

                <ImageButton
                    android:id="@+id/btnRight"
                    android:layout_width="72dp"
                    android:layout_height="72dp"
                    android:background="@drawable/button_dark"
                    android:src="@drawable/baseline_arrow_right_48"
                    android:contentDescription="@string/sGame_button_right"
                    app:tint="@color/snakeGm_controlBtn_arrowCl"
                    android:scaleType="center"
                    android:layout_marginStart="8dp" />

            </LinearLayout>

        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

</FrameLayout>
