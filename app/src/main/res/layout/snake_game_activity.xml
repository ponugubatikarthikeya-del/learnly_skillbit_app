<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#E8F7FF">
<RelativeLayout
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <!-- Title -->
    <TextView
        android:id="@+id/titleText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="SNAKE GAME"
        android:textSize="34sp"
        android:textStyle="bold"
        android:gravity="center"
        android:textColor="#0B2B3A"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="28dp" />

    <!-- Score -->
    <TextView
        android:id="@+id/scoreText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Score: 0"
        android:textSize="22sp"
        android:textColor="#0B2B3A"
        android:layout_below="@id/titleText"
        android:gravity="center_horizontal"
        app:layout_constraintTop_toBottomOf="@id/titleText"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="15dp"/>

    <!-- The game view (custom SurfaceView) -->

    <!-- Control container for restart + directional controls -->

    <!-- Restart button -->
    <com.example.learnly_skillbit_app.GameView
        android:id="@+id/gameView"
        android:layout_width="400dp"
        android:layout_height="400dp"
        android:layout_marginStart="5dp"
        android:layout_marginTop="25dp"
        android:layout_marginEnd="5dp"
        android:layout_marginBottom="18dp"
        android:layout_below="@id/scoreText"
       android:backgroundTint="@color/gray"
        android:layout_centerInParent="true"
        app:layout_constraintBottom_toTopOf="@id/controlContainer"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/scoreText"
        app:layout_constraintVertical_bias="0.0"
      />

    <LinearLayout
        android:id="@+id/controlContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:layout_below="@id/gameView"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center">

            <!-- Up -->
            <ImageButton
                android:id="@+id/btnUp"
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:background="@drawable/button_dark"
                android:src="@drawable/baseline_arrow_drop_up_24"
                android:contentDescription="Up"
                app:tint="#E6F0F4"
                android:scaleType="center"/>

            <!-- Row: left, center(empty), right -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center"
                android:layout_marginTop="8dp">

                <ImageButton
                    android:id="@+id/btnLeft"
                    android:layout_width="72dp"
                    android:layout_height="72dp"
                    android:background="@drawable/button_dark"
                    android:src="@drawable/baseline_arrow_left_24"
                    android:contentDescription="Left"
                    app:tint="#E6F0F4"
                    android:scaleType="center"
                    android:layout_marginEnd="8dp"/>

                <ImageButton
                    android:id="@+id/btnDown"
                    android:layout_width="72dp"
                    android:layout_height="72dp"
                    android:background="@drawable/button_dark"
                    android:contentDescription="Down"
                    android:scaleType="center"
                    android:src="@drawable/baseline_arrow_drop_down_24"
                    app:tint="#E6F0F4" />

                <ImageButton
                    android:id="@+id/btnRight"
                    android:layout_width="72dp"
                    android:layout_height="72dp"
                    android:background="@drawable/button_dark"
                    android:src="@drawable/baseline_arrow_right_48"
                    android:contentDescription="Right"
                    app:tint="@color/white"
                    android:layout_marginStart="8dp"/>
            </LinearLayout>

            <!-- Down -->
        </LinearLayout>
        <!-- Spacer -->
        <Space android:layout_width="1dp" android:layout_height="25dp"/>

        <!-- Directional keypad (Up on top, left/down/right in row) -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnstart"
            android:layout_width="160dp"
            android:layout_height="48dp"
            android:text="Start"
            android:textSize="18sp"
            app:cornerRadius="10dp"
            android:textColor="#0B2B3A"
            android:backgroundTint="#13A219"/>

    </LinearLayout>

</RelativeLayout>
    <!-- Title -->
</FrameLayout>
