<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/pageBackgrounds">

    <!-- HEADER BAR -->
    <ImageButton
        android:id="@+id/quizBackButton"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:background="@android:color/transparent"
        android:src="@drawable/back_arrow"
        app:tint="@color/white"
        android:contentDescription="@string/move_backSide"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
       android:layout_marginTop="35dp" />

    <TextView
        android:id="@+id/headerTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/quizzes"
        android:textColor="@color/white"
        android:textStyle="bold"
        android:textSize="26sp"
        android:gravity="center"
        android:paddingEnd="30dp"
        android:paddingStart="10dp"
        app:layout_constraintTop_toTopOf="@+id/quizBackButton"
        app:layout_constraintBottom_toBottomOf="@+id/quizBackButton"
        app:layout_constraintStart_toEndOf="@id/quizBackButton"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginEnd="30dp"/>

    <!-- SCROLL CONTENT -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/scrollContent"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintTop_toBottomOf="@id/quizBackButton"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent">

        <LinearLayout
            android:id="@+id/cardsContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:padding="16dp"
            android:gravity="center"
            android:orientation="vertical">

            <!-- *** REUSABLE CARD STYLE TEMPLATE *** -->
            <!-- PSYCHOLOGY CARD -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/quizPsychology"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginVertical="12dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="6dp"
                app:strokeWidth="0dp"
                android:contentDescription="@string/quiz_psychology"
                app:cardBackgroundColor="@color/quiz_itemsBg">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="35dp"
                    android:gravity="center">

                    <TextView
                        android:id="@+id/psychologyText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/quiz_psychology"
                        android:textColor="@color/white"
                        android:textSize="22sp"
                        android:textStyle="bold"
                        android:layout_marginBottom="12dp" />

                    <ImageView
                        android:layout_width="220dp"
                        android:layout_height="180dp"
                        android:src="@drawable/psycologybg"
                        android:scaleType="fitCenter"
                        android:contentDescription="@string/quiz_psychology"/>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- TECHNOLOGY CARD -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/quizTechnology"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginVertical="12dp"
                app:cardCornerRadius="16dp"
                app:strokeWidth="0dp"
                app:cardBackgroundColor="@color/quiz_itemsBg"
                android:contentDescription="@string/quiz_technology"
                app:cardElevation="6dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="30dp"
                    android:gravity="center">

                    <TextView
                        android:id="@+id/technologyText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/quiz_technology"
                        android:textColor="@color/white"
                        android:textSize="22sp"
                        android:textStyle="bold"
                        android:layout_marginBottom="12dp"/>

                    <ImageView
                        android:layout_width="220dp"
                        android:layout_height="180dp"
                        android:src="@drawable/quiz_technology_bg"
                        android:scaleType="fitCenter"
                        android:contentDescription="@string/quiz_technology"/>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- UNIVERSE CARD -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/quizUniverse"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginVertical="12dp"
                app:cardCornerRadius="16dp"
                app:cardBackgroundColor="@color/quiz_itemsBg"
                app:strokeWidth="0dp"
                android:contentDescription="@string/quiz_universe"
                app:cardElevation="6dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="30dp"
                    android:gravity="center">

                    <TextView
                        android:id="@+id/UniverseText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/quiz_universe"
                        android:textColor="@color/white"
                        android:textSize="22sp"
                        android:textStyle="bold"
                        android:layout_marginBottom="12dp"/>

                    <ImageView
                        android:layout_width="220dp"
                        android:layout_height="180dp"
                        android:src="@drawable/qui_universebg"
                        android:scaleType="fitCenter"
                        android:contentDescription="@string/quiz_universe"/>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
