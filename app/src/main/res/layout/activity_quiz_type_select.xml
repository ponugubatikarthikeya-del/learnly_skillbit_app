<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background">

    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/background"
        app:elevation="0dp"
        android:layout_marginTop="24dp">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            app:navigationIcon="@drawable/back_arrow"
            app:navigationIconTint="@color/on_background"
            app:title="@string/quizzes"
            app:titleTextColor="@color/on_background"
            app:titleCentered="true"
            app:titleTextAppearance="@style/TextAppearance.Material3.TitleLarge" />

    </com.google.android.material.appbar.AppBarLayout>

    <androidx.core.widget.NestedScrollView
        android:id="@+id/content_scroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:paddingBottom="72dp"
        android:clipToPadding="false"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:alpha="0.7"
                android:text="@string/choose_a_category_to_start"
                android:textColor="@color/on_background"
                android:textSize="16sp" />

            <androidx.gridlayout.widget.GridLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:columnCount="2"
                app:alignmentMode="alignMargins"
                app:columnOrderPreserved="false"
                app:useDefaultMargins="true">

                <!-- Psychology -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/quizPsychology"
                    style="@style/PremiumCard"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    app:layout_columnWeight="1">

                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">

                        <LinearLayout
                            android:id="@+id/contentPsychology"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center"
                            android:orientation="vertical"
                            android:padding="20dp">

                            <ImageView
                                android:layout_width="56dp"
                                android:layout_height="56dp"
                                android:contentDescription="@string/quiz_psychology"
                                android:src="@drawable/psycologybg" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="12dp"
                                android:text="@string/quiz_psychology"
                                android:textColor="@color/on_surface"
                                android:textSize="14sp"
                                android:textStyle="bold"
                                android:gravity="center" />
                        </LinearLayout>

                        <ImageView
                            android:id="@+id/lockPsychology"
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:layout_gravity="top|end"
                            android:layout_margin="12dp"
                            android:src="@drawable/outline_lock_24"
                            app:tint="@color/primary"
                            android:visibility="gone" />
                    </FrameLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Technology -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/quizTechnology"
                    style="@style/PremiumCard"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    app:layout_columnWeight="1">

                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">

                        <LinearLayout
                            android:id="@+id/contentTechnology"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center"
                            android:orientation="vertical"
                            android:padding="20dp">

                            <ImageView
                                android:layout_width="56dp"
                                android:layout_height="56dp"
                                android:contentDescription="@string/quiz_technology"
                                android:src="@drawable/quiz_technology_bg" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="12dp"
                                android:text="@string/quiz_technology"
                                android:textColor="@color/on_surface"
                                android:textSize="14sp"
                                android:textStyle="bold"
                                android:gravity="center" />
                        </LinearLayout>

                        <ImageView
                            android:id="@+id/lockTechnology"
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:layout_gravity="top|end"
                            android:layout_margin="12dp"
                            android:src="@drawable/outline_lock_24"
                            app:tint="@color/primary"
                            android:visibility="visible" />
                    </FrameLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Universe -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/quizUniverse"
                    style="@style/PremiumCard"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    app:layout_columnWeight="1">

                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">

                        <LinearLayout
                            android:id="@+id/contentUniverse"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center"
                            android:orientation="vertical"
                            android:padding="20dp">

                            <ImageView
                                android:layout_width="56dp"
                                android:layout_height="56dp"
                                android:contentDescription="@string/quiz_universe"
                                android:src="@drawable/qui_universebg" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="12dp"
                                android:text="@string/quiz_universe"
                                android:textColor="@color/on_surface"
                                android:textSize="14sp"
                                android:textStyle="bold"
                                android:gravity="center" />
                        </LinearLayout>

                        <ImageView
                            android:id="@+id/lockUniverse"
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:layout_gravity="top|end"
                            android:layout_margin="12dp"
                            android:src="@drawable/outline_lock_24"
                            app:tint="@color/primary"
                            android:visibility="visible" />
                    </FrameLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Science -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/quizScience"
                    style="@style/PremiumCard"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    app:layout_columnWeight="1">

                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">

                        <LinearLayout
                            android:id="@+id/contentScience"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center"
                            android:orientation="vertical"
                            android:padding="20dp">

                            <ImageView
                                android:layout_width="56dp"
                                android:layout_height="56dp"
                                android:contentDescription="@string/quiz_science"
                                android:src="@drawable/quiz_sci_img" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="12dp"
                                android:text="@string/quiz_science"
                                android:textColor="@color/on_surface"
                                android:textSize="14sp"
                                android:textStyle="bold"
                                android:gravity="center" />
                        </LinearLayout>

                        <ImageView
                            android:id="@+id/lockScience"
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:layout_gravity="top|end"
                            android:layout_margin="12dp"
                            android:src="@drawable/outline_lock_24"
                            app:tint="@color/primary"
                            android:visibility="visible" />
                    </FrameLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Sports -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/quizSports"
                    style="@style/PremiumCard"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    app:layout_columnWeight="1">

                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">

                        <LinearLayout
                            android:id="@+id/contentSports"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center"
                            android:orientation="vertical"
                            android:padding="20dp">

                            <ImageView
                                android:layout_width="56dp"
                                android:layout_height="56dp"
                                android:contentDescription="@string/quiz_sports"
                                android:src="@drawable/quiz_sports_img" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="12dp"
                                android:text="@string/quiz_sports"
                                android:textColor="@color/on_surface"
                                android:textSize="14sp"
                                android:textStyle="bold"
                                android:gravity="center" />
                        </LinearLayout>

                        <ImageView
                            android:id="@+id/lockSports"
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:layout_gravity="top|end"
                            android:layout_margin="12dp"
                            android:src="@drawable/outline_lock_24"
                            app:tint="@color/primary"
                            android:visibility="visible" />
                    </FrameLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Knowledge -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/quizKnowledge"
                    style="@style/PremiumCard"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    app:layout_columnWeight="1">

                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">

                        <LinearLayout
                            android:id="@+id/contentKnowledge"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center"
                            android:orientation="vertical"
                            android:padding="20dp">

                            <ImageView
                                android:layout_width="56dp"
                                android:layout_height="56dp"
                                android:contentDescription="@string/quiz_knowledge"
                                android:src="@drawable/quiz_gk_img" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="12dp"
                                android:text="@string/quiz_knowledge"
                                android:textColor="@color/on_surface"
                                android:textSize="14sp"
                                android:textStyle="bold"
                                android:gravity="center" />
                        </LinearLayout>

                        <ImageView
                            android:id="@+id/lockKnowledge"
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:layout_gravity="top|end"
                            android:layout_margin="12dp"
                            android:src="@drawable/outline_lock_24"
                            app:tint="@color/primary"
                            android:visibility="visible" />
                    </FrameLayout>
                </com.google.android.material.card.MaterialCardView>



            </androidx.gridlayout.widget.GridLayout>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <FrameLayout
        android:id="@+id/ad_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="50dp"
        android:background="@android:color/transparent"
        android:layout_gravity="bottom"/>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
