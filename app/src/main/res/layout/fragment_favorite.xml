<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/pageBackgrounds">

    <TextView
        android:id="@+id/favorites"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:padding="15dp"
        android:text="@string/Favorite"
        android:textColor="@color/white"
        android:textStyle="bold"
        android:textSize="30sp"
        android:layout_marginTop="30dp"/>
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerFavorites"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/favorites"/>

    <ImageView
        android:id="@+id/noFavImage"
        android:layout_width="270dp"
        android:layout_height="270dp"
        android:src="@drawable/no_favyet"
       android:layout_centerInParent="true"
        android:scaleType="centerCrop"
        android:contentDescription="@string/no_favorites_yet"/>

    <TextView
        android:id="@+id/textEmpty"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/no_favorites_yet"
        android:textColor="@color/noFavoriteTextBg"
        android:textSize="24sp"
        android:textStyle="bold"
        android:visibility="visible"
        android:layout_below="@id/noFavImage"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="10dp"/>
</RelativeLayout>